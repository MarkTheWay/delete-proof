{
  "name": "delete-proof",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "cli": "npm run cli -w packages/runner",
    "scenario": "npm run scenario -w packages/runner"
  },
  "devDependencies": {
    "rollup": "4.18.0",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
