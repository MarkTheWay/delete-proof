{
  "mcpServers": {
    "delete-proof": {
      "command": "npx",
      "args": ["tsx", "packages/mcp/src/server.ts"],
      "cwd": "${workspaceFolder}",
      "env": {
        "DATABASE_URL": "postgresql://deleteproof:deleteproof@127.0.0.1:5432/deleteproof",
        "REDIS_URL": "redis://127.0.0.1:6379",
        "SAMPLE_APP_PORT": "3100",
        "SAMPLE_APP_URL": "http://127.0.0.1:3100",
        "DELETEPROOF_TEST_HOOKS": "1"
      }
    }
  }
}
