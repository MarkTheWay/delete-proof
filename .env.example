# Infrastructure ports (docker-compose binds these on the host)
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL
POSTGRES_USER=deleteproof
POSTGRES_PASSWORD=deleteproof
POSTGRES_DB=deleteproof
DATABASE_URL=postgresql://deleteproof:deleteproof@localhost:5432/deleteproof

# Redis
REDIS_URL=redis://localhost:6379

# Sample app (Fastify API + BullMQ worker)
# Prefer 3100 if :3000 is already taken by another local app
SAMPLE_APP_PORT=3100
SAMPLE_APP_URL=http://127.0.0.1:3100
DELETEPROOF_TEST_HOOKS=1
BARRIER_TIMEOUT_MS=30000

# Runner HTTP API (dashboard + CLI orchestration)
RUNNER_PORT=3001

# Dashboard
VITE_API_URL=http://localhost:3001

# Without Docker: npm run services:up  (embedded-postgres + redis-memory-server → .dp-data/)
# With Docker:     docker compose up -d
# Tip: run a single start:api and start:worker (duplicate workers break barrier choreography)
